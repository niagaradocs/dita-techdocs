<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="ConfiguringTheHaystackDictionaryToA-EB847A80" xml:lang="en-us" class="- topic/topic task/task "><title class="- topic/title ">Configuring the Haystack dictionary to auto-import modifications</title><shortdesc class="- topic/shortdesc ">Automatic import of modified Haystack dictionary content is managed through JSON‑based import files. You can configure the Haystack dictionary so that any updated JSON import file is automatically applied whenever the station restarts.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">tagImportFile property</indexterm><indexterm class="- topic/indexterm ">equipImportFile property</indexterm><indexterm class="- topic/indexterm ">automatically import dictionary changes</indexterm><indexterm class="- topic/indexterm ">configure haystack auto-import</indexterm><indexterm class="- topic/indexterm ">haystack</indexterm></keywords></metadata></prolog><taskbody class="- topic/body task/taskbody "><prereq class="- topic/section task/prereq ">
            
        </prereq><context class="- topic/section task/context "/><steps class="- topic/ol task/steps "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To configure auto-import behavior, open the <uicontrol class="+ topic/ph ui-d/uicontrol ">HsTagDictionary</uicontrol> component in <keyword conkeyref="wh_variables_n4/Workbench" class="- topic/keyword "/>.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Locate the <parmname class="+ topic/keyword pr-d/parmname ">Import File Ord</parmname> (or <parmname class="+ topic/keyword pr-d/parmname ">Tags Import File</parmname>) property.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Set the property to reference the JSON import file you want <keyword conkeyref="wh_variables_n4/niagara" class="- topic/keyword "/> to load automatically.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Click <uicontrol class="+ topic/ph ui-d/uicontrol ">Save</uicontrol>.</cmd></step></steps><result class="- topic/section task/result ">When this property is set, <keyword conkeyref="wh_variables_n4/niagara" class="- topic/keyword "/>  will automatically:<ul class="- topic/ul "><li class="- topic/li ">Detect the referenced JSON file at station startup.</li><li class="- topic/li ">Validate the JSON against the  dictionary schema.</li><li class="- topic/li ">Apply any modifications contained in the import file.</li></ul>. </result><example class="- topic/example "/><postreq class="- topic/section task/postreq "/></taskbody></task>