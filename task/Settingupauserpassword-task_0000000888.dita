<task id="auth_SettingUpAUsersPassword" xml:lang="en-us" class="- topic/topic task/task ">
<title class="- topic/title ">Setting up a user's password</title>
<shortdesc class="- topic/shortdesc ">You configure user passwords through the UserService. If
you are accessing the UserService from a browser, your connection
must be secure (https) or you will be unable to set the password.</shortdesc>
<prolog class="- topic/prolog ">
<metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">password<indexterm class="- topic/indexterm ">setting up for a
user</indexterm></indexterm><indexterm class="- topic/indexterm ">UserService<indexterm class="- topic/indexterm ">setting
up a password</indexterm></indexterm><indexterm class="- topic/indexterm ">https<indexterm class="- topic/indexterm ">required
to set password in browser</indexterm></indexterm></keywords>
<prodinfo class="- topic/prodinfo ">
<prodname class="- topic/prodname "/>
<vrmlist class="- topic/vrmlist "><vrm version="4.0" class="- topic/vrm "/></vrmlist>
</prodinfo>
</metadata>
</prolog>
<taskbody class="- topic/body task/taskbody ">
<steps class="- topic/ol task/steps ">
<step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">UserServices</uicontrol> in the
Nav tree and double-click the user record.</cmd></step>
<step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To view the password properties, expand the <uicontrol class="+ topic/ph ui-d/uicontrol ">Authenticator</uicontrol>.</cmd></step>
<step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Enter and confirm the password, then click <uicontrol class="+ topic/ph ui-d/uicontrol ">OK</uicontrol>.</cmd></step>
</steps>
