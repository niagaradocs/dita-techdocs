<task id="LoggingInViaWorkbenchUsingClientCer-16356410" xml:lang="en-us" class="- topic/topic task/task "><title class="- topic/title ">Logging in via <keyword conkeyref="wh_variables_n4/Workbench" conref="../reuse/WH_SoftwareVariables_Tridium_N4_0000009934.dita#WHSoftwareVariablesTridium-9A3264AE/Workbench" class="- topic/keyword ">Workbench</keyword> using client certificate authentication</title><shortdesc class="- topic/shortdesc ">This procedure describes the steps to log in via your <keyword conkeyref="wh_variables_n4/Workbench" conref="../reuse/WH_SoftwareVariables_Tridium_N4_0000009934.dita#WHSoftwareVariablesTridium-9A3264AE/Workbench" class="- topic/keyword ">Workbench</keyword> to a station configured for client certificate
authentication.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">ClientCertAuth<indexterm class="- topic/indexterm ">users workflow<indexterm class="- topic/indexterm "><keyword conkeyref="wh_variables_n4/Workbench" conref="../reuse/WH_SoftwareVariables_Tridium_N4_0000009934.dita#WHSoftwareVariablesTridium-9A3264AE/Workbench" class="- topic/keyword ">Workbench</keyword> login</indexterm></indexterm></indexterm></keywords></metadata></prolog><taskbody class="- topic/body task/taskbody "><prereq class="- topic/section task/prereq "/><context class="- topic/section task/context "/><steps class="- topic/ol task/steps "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">In <keyword conkeyref="wh_variables_n4/Workbench" conref="../reuse/WH_SoftwareVariables_Tridium_N4_0000009934.dita#WHSoftwareVariablesTridium-9A3264AE/Workbench" class="- topic/keyword ">Workbench</keyword>, initiate the station connection.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Set the username to a user who is configured with the ClientCertAuthScheme.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">When prompted, select your client private certificate from the available certificates list and enter the certificate password.</cmd><info class="- topic/itemgroup task/info "><note class="- topic/note ">If your certificate does not use its own
password, select <parmname class="+ topic/keyword pr-d/parmname ">Use global certificate password</parmname>.</note></info></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Click <uicontrol class="+ topic/ph ui-d/uicontrol ">OK</uicontrol> to continue.</cmd><stepresult class="- topic/itemgroup task/stepresult ">If the certificate is correct for the user, you are authenticated to the station.</stepresult></step></steps><result class="- topic/section task/result ">You are immediately authenticated to the station.</result><example class="- topic/example "/><postreq class="- topic/section task/postreq "/></taskbody></task>