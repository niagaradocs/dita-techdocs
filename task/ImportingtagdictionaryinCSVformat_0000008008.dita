<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="ImportingTagDictionaryInCSV-799C096A" xml:lang="en-us" class="- topic/topic task/task "><title class="- topic/title ">Importing a tag dictionary in JSON format</title><shortdesc class="- topic/shortdesc ">After editing a tag dictionary outside of <keyword conkeyref="wh_variables_n4/niagara" class="- topic/keyword ">Niagara</keyword> this procedure brings the dictionary back into the framework.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">tag dictionaries<indexterm class="- topic/indexterm ">importing</indexterm></indexterm></keywords><prodinfo class="- topic/prodinfo "><prodname class="- topic/prodname "><keyword conkeyref="wh_variables_n4/niagara" class="- topic/keyword ">Niagara</keyword></prodname><vrmlist class="- topic/vrmlist "><vrm version="4.0" class="- topic/vrm "/></vrmlist></prodinfo></metadata></prolog><taskbody class="- topic/body task/taskbody "><prereq class="- topic/section task/prereq "><ul class="- topic/ul "><li class="- topic/li "><p class="- topic/p ">JSON syntax must be valid.</p></li><li class="- topic/li "><p class="- topic/p ">Each section must contain correctly structured objects.</p></li><li class="- topic/li "><p class="- topic/p ">All references (for example, tags referenced in rules) must resolve correctly.</p></li><li class="- topic/li "><p class="- topic/p ">The tag dictionary in JSON format is in your <keyword conkeyref="wh_variables_n4/Workbench" class="- topic/keyword ">Workbench</keyword> user home.</p></li></ul></prereq><steps class="- topic/ol task/steps "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Open the <wintitle class="+ topic/keyword ui-d/wintitle ">Tag Dictionary Manager</wintitle> view of the <uicontrol class="+ topic/ph ui-d/uicontrol ">TagDictionaryService</uicontrol>.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Select the tag dictionary to update and click <uicontrol class="+ topic/ph ui-d/uicontrol ">Import</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">A window confirms that the <uicontrol class="+ topic/ph ui-d/uicontrol ">Import</uicontrol> action will overwrite the selected tag dictionary.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To replace the dictionary, click <uicontrol class="+ topic/ph ui-d/uicontrol ">Yes</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">A <wintitle class="+ topic/keyword ui-d/wintitle ">File Chooser</wintitle> opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Locate and select the JSON file to import, and click <uicontrol class="+ topic/ph ui-d/uicontrol ">Open</uicontrol>.</cmd><info class="- topic/itemgroup task/info ">
                    
                <keyword conkeyref="wh_variables_n4/niagara" class="- topic/keyword "/> performs immediate validation:<ul class="- topic/ul "><li class="- topic/li ">Structural correctness</li><li class="- topic/li ">Valid keys and required fields</li><li class="- topic/li ">Proper rule syntax</li><li class="- topic/li ">Valid references between definitions, groups, and rules</li></ul></info><stepresult class="- topic/itemgroup task/stepresult ">A <wintitle class="+ topic/keyword ui-d/wintitle ">Results</wintitle> window notifies you that the JSON file imported successfully.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To continue, click <uicontrol class="+ topic/ph ui-d/uicontrol ">OK</uicontrol>.</cmd><info class="- topic/itemgroup task/info ">
                    <note class="- topic/note ">In the event that the framework detects an error in the JSON file, an <wintitle class="+ topic/keyword ui-d/wintitle ">Error</wintitle> window opens indicating the error and its location by row or line number.</note>
                </info></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To open the dictionary’s <wintitle class="+ topic/keyword ui-d/wintitle ">Property Sheet</wintitle>, expand the <uicontrol class="+ topic/ph ui-d/uicontrol ">TagDictionaryService</uicontrol> node in the Nav tree and double-click (or right-click) on the imported/updated tag dictionary. </cmd><stepresult class="- topic/itemgroup task/stepresult ">The <wintitle class="+ topic/keyword ui-d/wintitle ">Property Sheet</wintitle> opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Review its properties and verify your changes.</cmd></step></steps></taskbody></task>