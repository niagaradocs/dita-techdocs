<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="ConfiguringTheServerToSupportAnOpcU-CC223C9D" xml:lang="en-us" class="- topic/topic task/task "><title class="- topic/title ">Configuring the server to support an OPC UA client user</title><shortdesc class="- topic/shortdesc ">OPC UA clients require you to configure an authentication
scheme. This scheme assures that the identity of each user can be
verified. It may use roles to limit user access to only certain areas.
The scheme authenticates the user when he or she enters a username
and password, which are already configured for the user.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">user authentication<indexterm class="- topic/indexterm ">setting
up</indexterm></indexterm><indexterm class="- topic/indexterm ">authentication<indexterm class="- topic/indexterm ">setting
up for a user</indexterm></indexterm></keywords></metadata></prolog><taskbody class="- topic/body task/taskbody "><prereq class="- topic/section task/prereq "><ul class="- topic/ul "><li class="- topic/li "><p class="- topic/p ">You are connected to a running station that is configured with
the <uicontrol class="+ topic/ph ui-d/uicontrol ">OpcUaServer</uicontrol>.</p></li><li class="- topic/li "><p class="- topic/p ">The <apiname class="+ topic/keyword pr-d/apiname ">opcUaServer</apiname> palette is open.</p></li></ul></prereq><context class="- topic/section task/context "><note class="- topic/note ">When making any server-side changes, you must first
disable and then re-enable the server.</note></context><steps class="- topic/ol task/steps "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">In the Nav tree, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol></menucascade>, right-click <uicontrol class="+ topic/ph ui-d/uicontrol ">OpcUaServer</uicontrol> and click <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Views</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Property Sheet</uicontrol></menucascade>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">The server’s <wintitle class="+ topic/keyword ui-d/wintitle ">Property Sheet</wintitle> opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Under the <parmname class="+ topic/keyword pr-d/parmname ">Enabled</parmname> property, click
the drop-down list and click <option class="+ topic/keyword pr-d/option ">false</option> and <uicontrol class="+ topic/ph ui-d/uicontrol ">Save</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">The driver disables the <uicontrol class="+ topic/ph ui-d/uicontrol ">OpcUaServer</uicontrol>.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">In the Nav tree, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Services</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">AuthenticationService</uicontrol></menucascade>.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Drag the <uicontrol class="+ topic/ph ui-d/uicontrol ">OpcUaAuthenticationScheme</uicontrol> component from the <apiname class="+ topic/keyword pr-d/apiname ">opcUaServer</apiname> palette to the
station’s <uicontrol class="+ topic/ph ui-d/uicontrol ">Authentication Schemes</uicontrol> subfolder.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Services</uicontrol></menucascade> and double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">UserService</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">The <wintitle class="+ topic/keyword ui-d/wintitle ">User Manager</wintitle> opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To add a single new user, click <uicontrol class="+ topic/ph ui-d/uicontrol ">New</uicontrol> and click <uicontrol class="+ topic/ph ui-d/uicontrol ">OK</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">A second <wintitle class="+ topic/keyword ui-d/wintitle ">New</wintitle> window opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Configure these properties and click <uicontrol class="+ topic/ph ui-d/uicontrol ">Ok</uicontrol>.:</cmd><info class="- topic/itemgroup task/info "><ul class="- topic/ul "><li class="- topic/li "><p class="- topic/p ">For <parmname class="+ topic/keyword pr-d/parmname ">Name</parmname> enter the user’s name.</p></li><li class="- topic/li "><p class="- topic/p ">For <parmname class="+ topic/keyword pr-d/parmname ">Authentication Scheme Name</parmname>, select
a scheme from the drop-down list.</p></li><li class="- topic/li "><p class="- topic/p ">For <parmname class="+ topic/keyword pr-d/parmname ">Password</parmname>, create a strong password
and enter it a second time in the <parmname class="+ topic/keyword pr-d/parmname ">Confirm</parmname> property.</p></li></ul><p class="- topic/p ">A strong password requires at least ten characters, plus at
least one of each of the following characters: lowercase, uppercase,
and a digit.</p></info></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">If you use the same default password for all new users
set the <parmname class="+ topic/keyword pr-d/parmname ">Force Reset At Next Login</parmname> value to <option class="+ topic/keyword pr-d/option ">true</option>.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">To enable the server, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol></menucascade>, right-click <uicontrol class="+ topic/ph ui-d/uicontrol ">OpcUaServer</uicontrol> and click <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Views</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Property Sheet</uicontrol></menucascade>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">The <wintitle class="+ topic/keyword ui-d/wintitle ">Property Sheet</wintitle> opens.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Set <parmname class="+ topic/keyword pr-d/parmname ">Enabled</parmname> to <option class="+ topic/keyword pr-d/option ">true</option> and click <uicontrol class="+ topic/ph ui-d/uicontrol ">Save</uicontrol>.</cmd><stepresult class="- topic/itemgroup task/stepresult ">The server is ready to support an OPC UA client user.</stepresult></step></steps></taskbody></task>