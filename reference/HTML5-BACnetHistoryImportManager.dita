as the <keyword conkeyref="wh_variables_n4/Workbench" class="- topic/keyword "/> view.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">HTML-5– BACnet history import manager</indexterm></keywords></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section "><fig class="- topic/fig "><title class="- topic/title ">BACnetScheduleImportUxManager</title><image placement="break" scale="65" width="750" href="../graphic/BacnetHistoryImportUX.png" class="- topic/image "/></fig><p class="- topic/p ">To access this view, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetNetwork</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetDevice</uicontrol></menucascade> and double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">Trend Logs</uicontrol> or right-click <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Trend
Logs</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Views</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Bacnet History
