                    <p conref="../reuse/WH-guide-General_0000048987.dita#descGen/bacnetTSync-p" class="- topic/p "/>
                </li><li class="- topic/li ">
                    <p class="- topic/p "><uicontrol class="+ topic/ph ui-d/uicontrol ">DeviceID</uicontrol> changes the device ID in the device.</p>
                </li><li class="- topic/li ">
                    <p class="- topic/p "><uicontrol class="+ topic/ph ui-d/uicontrol ">Events</uicontrol> retrieves the current event information to the alarm console.</p>
                </li><li class="- topic/li ">
                    <p class="- topic/p "><uicontrol class="+ topic/ph ui-d/uicontrol ">ESumm</uicontrol> provides the event summary for the event initiating objects.</p>
