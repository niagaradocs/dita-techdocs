<reference id="bacnetAws-BacnetAccumulator" xml:lang="en" class="- topic/topic       reference/reference "><title class="- topic/title ">ACC</title><shortdesc class="- topic/shortdesc "> This component is a Config object that represents a Bacnet Accumulator object. The Accumulator object represents the characteristics of a meter that indicate measurements by counting pulses.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">ACC</indexterm><indexterm class="- topic/indexterm ">Bacnet Accumulator</indexterm></keywords></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section ">
            <fig class="- topic/fig "><title class="- topic/title ">ACC properties</title><image placement="break" scale="65" width="700" href="../graphic/ACC_0000083867.png" class="- topic/image "/></fig>
            <p class="- topic/p ">To access these properties, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetAwsNetwork</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetAwsDevice</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol></menucascade> and double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">ACC</uicontrol>.</p>
            <p class="- topic/p ">In addition to the common properties (Status and Fault Cause), this component has these properties.</p>
        </section><properties class="- topic/simpletable reference/properties "><prophead class="- topic/sthead      reference/prophead "><proptypehd class="- topic/stentry     reference/proptypehd ">Property</proptypehd><propvaluehd class="- topic/stentry     reference/propvaluehd ">Value</propvaluehd><propdeschd class="- topic/stentry     reference/propdeschd ">Description</propdeschd></prophead><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Poll Frequency</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list (defaults to <option class="+ topic/keyword pr-d/option ">Normal</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                References the On Demand Poll Scheduler rates under the NiagaraNetwork's
History Policies container slot.
Configures how often this type of poll occurs.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Id</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list and number (from 0 to 4194302)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/bacnetObjextId-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Name</proptype><propvalue class="- topic/stentry     reference/propvalue ">text in the format <userinput class="+ topic/ph sw-d/userinput ">name.name.name.name</userinput> (default includes the entire component path in the station using period (“/) delimiters between parent.child levels)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetObjectName-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Type</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list of BACnet objects</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetObjectType-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Facets</proptype><propvalue class="- topic/stentry     reference/propvalue ">Config window or read-only property</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Identifies the units used for the current component or point value. These could be parent or child point facets.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Enable</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> (default) or <option class="+ topic/keyword pr-d/option ">false</option></propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/Enabled-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Status Flags</proptype><propvalue class="- topic/stentry     reference/propvalue ">read-only indicator and check boxes</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetStatusFlags-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Event State</proptype><propvalue class="- topic/stentry     reference/propvalue ">read-only</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetEventState-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Out Of Service</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> (default) or <option class="+ topic/keyword pr-d/option ">false</option></propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    
                <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetOutOfService-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Scale</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Allows you to select the scaling factor for the accumulator. This determines how the raw pulse or count value is converted into engineering units. </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Max Pres Value</proptype><propvalue class="- topic/stentry     reference/propvalue ">defaults to +inf</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the maximum present value that the accumulator can reach. It is used to prevent overflow and to define the valid range for the accumulated measurement.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Logging Record</proptype><propvalue class="- topic/stentry     reference/propvalue ">additional properties</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Configures  how the accumulator's data is logged or recorded. This may include settings for the type of data to log, the logging interval, or other parameters related to the historical recording of the accumulator's values. </propdesc></property></properties></refbody></reference>