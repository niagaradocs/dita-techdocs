<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference-114" xml:lang="en-us" class="- topic/topic       reference/reference "><title class="- topic/title ">New station window</title><shortdesc class="- topic/shortdesc ">This window allows you to create a new Niagara station. Each station operates independently and can communicate with other stations over a NiagaraNetwork.</shortdesc><prolog class="- topic/prolog "><author translate="no" type="creator" class="- topic/author ">ClaudiaSerwe &lt;claudia.serwe@tridium.com&gt;</author><metadata class="- topic/metadata "><keywords class="- topic/keywords "/></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section ">
            <title class="- topic/title "/>
            <p class="- topic/p "/><p class="- topic/p "><image placement="break" width="800" href="../graphic/NewStation.png" class="- topic/image "/></p><p class="- topic/p ">To access this window, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol></menucascade> and double-click NiagaraNetwork. In the <wintitle class="+ topic/keyword ui-d/wintitle ">Station Manager</wintitle> view, click <uicontrol class="+ topic/ph ui-d/uicontrol ">New</uicontrol>. </p>
        </section><properties class="- topic/simpletable reference/properties "><prophead class="- topic/sthead      reference/prophead "><proptypehd class="- topic/stentry     reference/proptypehd ">Property</proptypehd><propvaluehd class="- topic/stentry     reference/propvaluehd ">Value</propvaluehd><propdeschd class="- topic/stentry     reference/propdeschd ">Description</propdeschd></prophead><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Name</proptype><propvalue class="- topic/stentry     reference/propvalue ">Text</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies a unique name for the new station. This name is used to identify the station within the NiagaraNetwork and on the host machine.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Type</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down </propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the type of station.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Address</proptype><propvalue class="- topic/stentry     reference/propvalue ">IP address or hostname</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the IP address or DNS name of the  station. It is used for network routing and connection.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Port</proptype><propvalue class="- topic/stentry     reference/propvalue ">Integer (defaults to 4911)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">The Fox/Foxs port used for secure station communication. Default is 4911 for Foxs.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Use Foxs</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">true</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Enables secure Foxs protocol (TLS encrypted). Set to <option class="+ topic/keyword pr-d/option ">true</option> for encrypted, authenticated communication.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Fox Over WebSocket</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Determines if Fox over WebSocket (foxwss) is used as a fallback or exclusively.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Fox Over WebSocket Port</proptype><propvalue class="- topic/stentry     reference/propvalue ">Integer (defaults to 443)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">The HTTPS port used for Fox over WebSocket connections. Should match the remote station’s WebService HTTPS port.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Credential Store</proptype><propvalue class="- topic/stentry     reference/propvalue ">Drop-down: UsernameAndPassword / CertificateAliasCredential</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Selects the authentication method. "UsernameAndPassword" requires user credentials; "CertificateAliasCredential" uses a client certificate for authentication.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">UsernameAndPassword</proptype><propvalue class="- topic/stentry     reference/propvalue ">text</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Authenticates
using a standard username and password combination.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">CertificateAliasCredential</proptype><propvalue class="- topic/stentry     reference/propvalue ">text </propvalue><propdesc class="- topic/stentry     reference/propdesc ">Authenticates
using a client certificate stored in the User Key Store. This method supports
secure TLS communication and is recommended for station-to-station
authentication.<ul class="- topic/ul "><li class="- topic/li "><p class="- topic/p ">Username: The login name associated with the certificate.</p></li><li class="- topic/li "><p class="- topic/p ">Password: Either a manually entered password or the option to use the global certificate password.</p></li><li class="- topic/li "><p class="- topic/p ">Use Global Certificate Password: If enabled, the system uses a shared password configured globally for certificate-based authentication.</p></li></ul></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Enabled</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">true</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Activates (<option class="+ topic/keyword pr-d/option ">true</option>) or deactivates (<option class="+ topic/keyword pr-d/option ">false</option>) the station object. It must be <option class="+ topic/keyword pr-d/option ">true</option> for the connection to succeed.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Virtuals Enabled</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">false</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Enables (<option class="+ topic/keyword pr-d/option ">true</option>) or disables (<option class="+ topic/keyword pr-d/option ">false</option>) access to virtual components in this station by users with virtual gateway permissions.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Sec Dash Import Enabled</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">true</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Enables (true) or disables (false) the import of the security dashboard for this station.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Sec Dash Import Time</proptype><propvalue class="- topic/stentry     reference/propvalue ">Time of day (defaults to 2:00 AM), Days of week</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Configures when to import the security dashboard for this station. You can set it for specific days and times, with optional randomization.</propdesc></property><property class="- topic/strow       reference/property "/><property class="- topic/strow       reference/property "/><property class="- topic/strow       reference/property "/><property class="- topic/strow       reference/property "/></properties></refbody></reference>