<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="kitControl-Maximum" xml:lang="en" class="- topic/topic       reference/reference ">
<title class="- topic/title ">kitControl-Maximum</title>
<shortdesc class="- topic/shortdesc ">This component determines the maximum value of valid inputs
and writes that value to the <parmname class="+ topic/keyword pr-d/parmname ">Out</parmname> property. <codeph class="+ topic/ph pr-d/codeph ">Out = max (inA, inB, inC, inD)</codeph>. </shortdesc>
<prolog class="- topic/prolog ">
<metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">Maximum</indexterm></keywords></metadata>
</prolog>
<refbody class="- topic/body        reference/refbody ">
<section class="- topic/section "><p class="- topic/p ">Maximum is available in the <uicontrol class="+ topic/ph ui-d/uicontrol ">Math</uicontrol> folder of the <apiname class="+ topic/keyword pr-d/apiname ">kitControl</apiname> palette</p></section>
</refbody>
</reference>