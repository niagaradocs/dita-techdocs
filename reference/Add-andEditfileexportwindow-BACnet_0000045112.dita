<reference id="AddandEditFileExportWindowBACnet-5414BDC9" xml:lang="en" class="- topic/topic       reference/reference "><title class="- topic/title ">New (and Edit) file export window</title><shortdesc class="- topic/shortdesc ">This window prepares files for export.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">file export </indexterm></keywords></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section ">
