<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="kitControl-BooleanConst" xml:lang="en" class="- topic/topic       reference/reference ">
<title class="- topic/title ">kitControl-BooleanConst</title>
<shortdesc class="- topic/shortdesc ">This component provides a constant status Boolean value
with two actions to set.</shortdesc>
<prolog class="- topic/prolog ">
<metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">BooleanCount</indexterm></keywords>
</metadata>
</prolog>
<refbody class="- topic/body        reference/refbody ">
<section class="- topic/section "><p class="- topic/p ">BooleanConst is available in the <uicontrol class="+ topic/ph ui-d/uicontrol ">Constants</uicontrol> folder of the <apiname class="+ topic/keyword pr-d/apiname ">kitControl</apiname> palette.</p><p class="- topic/p ">It provides
a linkable status-type output value, and two actions for changing
its value: Active (true) and Inactive (false).</p><fig class="- topic/fig ">
<title class="- topic/title ">BooleanConst properties</title>
<image href="../graphic/kitControlBooleanConst_0000067547.png" placement="break" scale="65" scope="local" class="- topic/image "/>
</fig></section>
<properties class="- topic/simpletable reference/properties ">
<prophead class="- topic/sthead      reference/prophead ">
<proptypehd class="- topic/stentry     reference/proptypehd ">Property</proptypehd>
<propvaluehd class="- topic/stentry     reference/propvaluehd ">Value</propvaluehd>
<propdeschd class="- topic/stentry     reference/propdeschd ">Description</propdeschd>
</prophead>
<property class="- topic/strow       reference/property ">
<proptype class="- topic/stentry     reference/proptype ">Facets</proptype>
<propvalue class="- topic/stentry     reference/propvalue ">Config Facets window (defaults to <systemoutput class="+ topic/ph sw-d/systemoutput ">true</systemoutput> and <systemoutput class="+ topic/ph sw-d/systemoutput ">false</systemoutput>)</propvalue>
<propdesc class="- topic/stentry     reference/propdesc ">Defines a range of enumerated states ( Boolean values).</propdesc>
</property>
<property class="- topic/strow       reference/property ">
<proptype class="- topic/stentry     reference/proptype ">Out</proptype>
<propvalue class="- topic/stentry     reference/propvalue ">StatusBoolean <option class="+ topic/keyword pr-d/option ">true</option> and <option class="+ topic/keyword pr-d/option ">false</option> (default) and null definition</propvalue>
<propdesc class="- topic/stentry     reference/propdesc ">Shows the current binary state of the point (on or off).</propdesc>
</property>
</properties>
</refbody>
</reference>