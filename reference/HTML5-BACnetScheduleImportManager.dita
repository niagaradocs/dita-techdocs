as the <keyword conkeyref="wh_variables_n4/Workbench" class="- topic/keyword "/> view.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">BACnet schedule import manager</indexterm></keywords></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section "><fig class="- topic/fig "><title class="- topic/title ">BACnetScheduleImportUxManager</title><image placement="break" scale="65" width="750" href="../graphic/BacnetScheduleImportManagerUX.png" class="- topic/image "/></fig><p class="- topic/p ">To access this view, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetNetwork</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetDevice</uicontrol></menucascade> and double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">Schedules</uicontrol> or right-click <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Schedules</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Views</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Bacnet Schedule Import Manager</uicontrol></menucascade>.</p></section><section class="- topic/section "><title class="- topic/title ">Columns</title><table class="- topic/table "><tgroup cols="2" class="- topic/tgroup "><colspec colname="col1" class="- topic/colspec "/><colspec colname="col2" class="- topic/colspec "/><thead class="- topic/thead "><row class="- topic/row "><entry class="- topic/entry ">Column Name</entry><entry class="- topic/entry ">Description</entry></row></thead><tbody class="- topic/tbody "><row class="- topic/row "><entry class="- topic/entry ">Name</entry><entry class="- topic/entry "><div conref="../reuse/Reuse1.dita#Reuse1-CAD76