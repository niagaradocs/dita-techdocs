perty "><proptype class="- topic/stentry     reference/proptype ">Out of Service</proptype><propvalue class="- topic/stentry     reference/propvalue "><option class="+ topic/keyword pr-d/option ">true</option> (default) or <option class="+ topic/keyword pr-d/option ">false</option></propvalue><propdesc class="- topic/stentry     reference/propdesc "><div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetOutOfService-div" class="- topic/div "/></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Priority Array</proptype><propvalue class="- topic/stentry     reference/propvalue ">array</propvalue><propdesc class="- topic/stentry     reference/propdesc "><div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetPriorityArray-div" class="- topic/div "/>This array is for <parmname class="+ topic/keyword pr-d/parmname ">Notification Class</parmname> priorities.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Door Pulse Time</proptype><propvalue class="- topic/stentry     reference/propvalue ">number</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the duration of a pulse  sent to the door hardware to trigger a standard door operation. the door. This value determines how long the pulse signal is maintained when the door is activated.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Door Extended Pulse Time</proptype><propvalue class="- topic/stentry     reference/propvalue ">number</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the duration of an extended pulse sent to the door hardware. The value defines how long the extended pulse signal is maintained.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Door Open Too Long Time</proptype><propvalue class="- topic/stentry     reference/propvalue ">number</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Sets the maximum allowable time  that the door can remain open before an alarm or event is triggered.</propdesc></property></properties></refbody></reference>