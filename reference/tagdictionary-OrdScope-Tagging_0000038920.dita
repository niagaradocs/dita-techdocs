<reference id="Tagdictionary-OrdScopeTagging-FA79F7DA" xml:lang="en" class="- topic/topic       reference/reference "><title class="- topic/title ">tagdictionary-OrdScope</title><shortdesc class="- topic/shortdesc ">You add the <uicontrol class="+ topic/ph ui-d/uicontrol ">OrdScope</uicontrol> component to
the scope list container or a ScopedTagRule. Added <uicontrol class="+ topic/ph ui-d/uicontrol ">OrdScopes</uicontrol> are, in effect, adding another condition to the rule.</shortdesc><prolog class="- topic/prolog "><metadata class="- topic/metadata "><keywords class="- topic/keywords "><indexterm class="- topic/indexterm ">scopes<indexterm class="- topic/indexterm ">OrdScope</indexterm></indexterm></keywords></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section "><note class="- topic/note ">In order for the rule to be applied, the component
must be located at or under the scopeOrd and not located under any
of the excludedScopeOrds. </note><p class="- topic/p ">The <parmname class="+ topic/keyword pr-d/parmname ">OrdScope</parmname> components are available in the <apiname class="+ topic/keyword pr-d/apiname ">tagdictionary</apiname> palette.</p><title class="- topic/title ">Properties</title></section><properties class="- topic/simpletable reference/properties "><prophead class="- topic/sthead      reference/prophead "><proptypehd class="- topic/stentry     reference/proptypehd ">Property</proptypehd><propvaluehd class="- topic/stentry     reference/propvaluehd ">Value</propvaluehd><propdeschd class="- topic/stentry     reference/propdeschd ">Description</propdeschd></prophead><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Scope Ord</proptype><propvalue class="- topic/stentry     reference/propvalue ">ord, null (default)</propvalue><propdesc class="- topic/stentry     reference/propdesc "><div conkeyref="reusekey/gen_scopeord" class="- topic/div "><div class="- topic/div "/></div></propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Exclude Scope Ords</proptype><propvalue class="- topic/stentry     reference/propvalue ">Ord List</propvalue><propdesc class="- topic/stentry     reference/propdesc "><div conkeyref="reusekey/gen_exscopeord" class="- topic/div "/></propdesc></property></properties></refbody></reference>