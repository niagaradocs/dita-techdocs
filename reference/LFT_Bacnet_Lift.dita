<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference-9521" xml:lang="en-us" class="- topic/topic       reference/reference "><title class="- topic/title ">LFT (Bacnet Lift)</title><shortdesc class="- topic/shortdesc ">The Lift object represents a single elevator car and provides operational status, such as position, movement, door status, load, and alarms, to a BACnet building automation system.</shortdesc><prolog class="- topic/prolog "><author translate="no" type="creator" class="- topic/author ">ClaudiaSerwe &lt;claudia.serwe@tridium.com&gt;</author><metadata class="- topic/metadata "><keywords class="- topic/keywords "/></metadata></prolog><refbody class="- topic/body        reference/refbody "><section class="- topic/section ">
            <fig class="- topic/fig "><title class="- topic/title ">LFT properties</title><image placement="break" scale="70" width="600" href="../graphic/Lift_BacnetObject.png" class="- topic/image "/></fig>
            <p class="- topic/p ">This component is available in the <apiname class="+ topic/keyword pr-d/apiname ">bacnetAws</apiname> palette, <apiname class="+ topic/keyword pr-d/apiname ">bacnetOws</apiname> palette, and the <apiname class="+ topic/keyword pr-d/apiname ">bacnet</apiname> palette.</p><?Pub Caret 77?>
            <p class="- topic/p ">To access these properties, expand <menucascade class="+ topic/ph ui-d/menucascade "><uicontrol class="+ topic/ph ui-d/uicontrol ">Drivers</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetAwsNetwork or BacnetNetwork</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">BacnetAwsDevice or BacnetDevice</uicontrol><uicontrol class="+ topic/ph ui-d/uicontrol ">Config</uicontrol></menucascade> and double-click <uicontrol class="+ topic/ph ui-d/uicontrol ">LFT</uicontrol>.</p>
            <p class="- topic/p ">In addition to the common properties (Status and Fault Cause), this component has these properties.</p>
        </section><properties class="- topic/simpletable reference/properties "><prophead class="- topic/sthead      reference/prophead "><proptypehd class="- topic/stentry     reference/proptypehd ">Property</proptypehd><propvaluehd class="- topic/stentry     reference/propvaluehd ">Value</propvaluehd><propdeschd class="- topic/stentry     reference/propdeschd ">Description</propdeschd></prophead><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Poll Frequency</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list (defaults to <option class="+ topic/keyword pr-d/option ">Normal</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/OnDemandPollFrequency-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Id</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list and number </propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/bacnetObjextId-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Name</proptype><propvalue class="- topic/stentry     reference/propvalue ">text in the format <userinput class="+ topic/ph sw-d/userinput ">name.name.name.name</userinput> (default includes the entire component path in the station using period (“/) delimiters between parent.child levels)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetObjectName-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Object Type</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list of BACnet objects</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/WH-guide-BACnet.dita#WH-guide-BACnet-0ED816BF/bacnetObjectType-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Status Flags</proptype><propvalue class="- topic/stentry     reference/propvalue ">number</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Indicates  the general health of the lift</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Elevator Group</proptype><propvalue class="- topic/stentry     reference/propvalue ">drop-down list and number</propvalue><propdesc class="- topic/stentry     reference/propdesc ">References to the Elevator Group object this lift belongs to, if any.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Group Id</proptype><propvalue class="- topic/stentry     reference/propvalue ">number</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Defines the identification number for the group of lifts that contains the lift represented
by this object.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Installation Id</proptype><propvalue class="- topic/stentry     reference/propvalue "> number</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Provides the identification number for the lift represented by this object</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Car Position</proptype><propvalue class="- topic/stentry     reference/propvalue "> number</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Indicates the universal floor number of this lift's car position.
</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Car Moving Direction</proptype><propvalue class="- topic/stentry     reference/propvalue "> drop-down menu</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Represents whether or not this lift's car is moving, and if so, in which direction.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Car Door Status</proptype><propvalue class="- topic/stentry     reference/propvalue "> read-only</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Indicates the status of the doors on the car.</propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Passenger Alarm</proptype><propvalue class="- topic/stentry     reference/propvalue "> <option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">false</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Indicates whether a passenger alarm condition is active. </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Ouf Of Service</proptype><propvalue class="- topic/stentry     reference/propvalue "> <option class="+ topic/keyword pr-d/option ">true</option> or <option class="+ topic/keyword pr-d/option ">false</option> (defaults to <option class="+ topic/keyword pr-d/option ">false</option>)</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Indicates  whether the object is decoupled from the lift that this
object represents. </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Fault Signals</proptype><propvalue class="- topic/stentry     reference/propvalue "> read-only</propvalue><propdesc class="- topic/stentry     reference/propdesc "> Displays a list of values that indicates fault conditions of the lift
 </propdesc></property></properties></refbody></reference>