                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">History Name</proptype><propvalue class="- topic/stentry     reference/propvalue ">BFormat string (defaults to %parent.name%)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
