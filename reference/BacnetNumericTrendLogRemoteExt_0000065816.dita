                    <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/gen_DaysOfWeek-div" class="- topic/div "/>
                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Active Period, Time Range</proptype><propvalue class="- topic/stentry     reference/propvalue ">from and to times (both default to 12 AM EDT</propvalue><propdesc class="- topic/stentry     reference/propdesc ">
                    <div conref="../reuse/Reuse1.dita#Reuse1-CAD76CAC/gen_TimeRange-div" class="- topic/div "/>
