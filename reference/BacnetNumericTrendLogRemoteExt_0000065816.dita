                </propdesc></property><property class="- topic/strow       reference/property "><proptype class="- topic/stentry     reference/proptype ">Cov Resubscription Interval</proptype><propvalue class="- topic/stentry     reference/propvalue ">time range (defaults to 5 minutes)</propvalue><propdesc class="- topic/stentry     reference/propdesc ">Specifies the length of time that the extension waits before initiating a re-subscription request.</propdesc></property></properties></refbody></reference>